---
import { Image } from 'astro:assets';
import photo from '../assets/avatar-2d.jpg';
import Avatar3D from '../components/Avatar3D.astro';
import { contacts, education, experience } from '../data/profile';
import { skills } from '../data/skills';
import type { Locale } from '../i18n/ui';
import { localizePath, t } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { getProjects, slugOf } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = await getProjects(locale);
const links = [
  ...projects.map((p) => ({ href: localizePath(locale, `projects/${slugOf(p)}/`), label: p.data.title, tagline: p.data.tagline })),
  { href: localizePath(locale, 'about/#workflow'), label: t(locale, 'home.workflowLink'), tagline: t(locale, 'home.workflowTagline') },
];
---
<Base locale={locale} path="" description={t(locale, 'home.bio')} bare>
  <div class="sheet">
    <figure class="photo" data-reveal style="--i: 0">
      <Image src={photo} alt={t(locale, 'home.photoAlt')} widths={[400, 700, 1024]} sizes="(min-width: 1100px) 300px, 100vw" loading="eager" fetchpriority="high" />
    </figure>

    <section class="hello" data-reveal style="--i: 1" aria-labelledby="hello-title">
      <h1 id="hello-title">{t(locale, 'home.hello')}</h1>
      <p class="bio">{t(locale, 'home.bio')}</p>
      <p class="enjoy">{t(locale, 'home.enjoy')}</p>
    </section>

    <section class="projects" data-reveal style="--i: 2" aria-labelledby="projects-title">
      <h2 id="projects-title">{t(locale, 'home.projects')}</h2>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>
                <b>{link.label} →</b>
                <span>{link.tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="skills" data-reveal style="--i: 3" aria-labelledby="skills-title">
      <h2 id="skills-title">{t(locale, 'home.skills')}</h2>
      <ul>
        {
          skills.map((skill) => (
            <li aria-label={skill.name} title={skill.name}>
              {skill.path ? (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={skill.path} />
                </svg>
              ) : (
                <span aria-hidden="true">{skill.name}</span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="experience" data-reveal style="--i: 4" aria-labelledby="experience-title">
      <h2 id="experience-title">{t(locale, 'home.experience')}</h2>
      <ol>
        {
          experience.map((job) => (
            <li>
              <b>{job.period[locale]}</b>
              <p>{job.text[locale]}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="education" data-reveal style="--i: 5" aria-labelledby="education-title">
      <h2 id="education-title">{t(locale, 'home.education')}</h2>
      <p class="degree">{education.degree[locale]}</p>
      <p>{education.note[locale]}</p>
    </section>

    <ul class="contacts" data-reveal style="--i: 6" aria-label={t(locale, 'home.contacts')}>
      <li>
        <a href={`mailto:${contacts.email}`}>
          <i aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></i>{contacts.email}
        </a>
      </li>
      <li>
        <a href={contacts.github}>
          <i aria-hidden="true"
            ><svg viewBox="0 0 24 24"
              ><path
                d="M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.3 5.8 2.6 5.8 2.6a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
              /></svg
            ></i
          >GitHub
        </a>
      </li>
      <li>
        <span>
          <i aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg></i>{contacts.languages[locale]}
        </span>
      </li>
    </ul>

    <div class="figure"><Avatar3D label={t(locale, 'home.avatarAlt')} /></div>
  </div>
</Base>

<script>
  import { startMotion } from '../lib/motion';
  startMotion();
</script>

<style>
  /* Phones and small windows: one column, natural scrolling. */
  .sheet {
    display: grid;
    gap: 36px;
    max-width: 640px;
    margin: 0 auto;
    padding: 64px 20px 48px;
  }
  .photo {
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 12px 32px rgb(0 0 0 / 0.08);
    aspect-ratio: 1 / 1;
  }
  /* The whole illustration, never cropped: the card is white like the picture's own background. */
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  h1 {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    margin: 0 0 22px;
    font-size: clamp(56px, 9vw, 84px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  /* Japanese greeting is six full-width characters: smaller so it stays on one line. */
  h1:lang(ja) {
    font-size: clamp(40px, 12vw, 64px);
  }
  h2 {
    margin: 0 0 14px;
    font-size: clamp(32px, 5vh, 46px);
    font-weight: 800;
    line-height: 1.05;
  }
  p {
    margin: 0;
    font-size: 13px;
    line-height: 1.65;
  }
  .enjoy {
    margin-top: 20px;
    font-size: 14px;
  }
  .projects ul {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects a {
    display: grid;
    gap: 4px;
    color: var(--fg);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .projects a:hover {
    opacity: 0.6;
  }
  .projects b {
    justify-self: start;
    padding-bottom: 1px;
    border-bottom: 2px solid var(--fg);
    font-size: 14px;
    font-weight: 800;
  }
  .projects span {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .degree {
    margin-bottom: 14px;
    font-weight: 800;
  }
  .skills ul {
    display: grid;
    grid-template-columns: repeat(3, 48px);
    gap: 22px 24px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .skills li {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 3px;
    background: var(--tag-bg);
    color: var(--tag-fg);
  }
  .skills svg {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }
  .skills span {
    font-size: 12px;
    font-weight: 800;
  }
  .experience ol {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .experience b {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 800;
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  .contacts a,
  .contacts span {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    text-decoration: none;
  }
  .contacts a:hover {
    text-decoration: underline;
  }
  .contacts i {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--fg);
  }
  .contacts svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .figure {
    width: 200px;
    justify-self: center;
  }

  /* Laptops and up: the reference layout on exactly one screen. */
  @media (min-width: 1100px) and (min-height: 700px) {
    .sheet {
      position: relative;
      grid-template-columns: minmax(240px, 300px) minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'photo hello skills'
        'projects edu exp'
        'projects contacts contacts';
      gap: 0 40px;
      max-width: 1240px;
      height: 100dvh;
      padding: 44px 0 40px 44px;
      overflow: hidden;
    }
    /* Square, exactly the picture, its top level with the greeting; the projects take the space under it. */
    .photo {
      grid-area: photo;
      align-self: start;
      margin-top: 40px;
    }
    .hello {
      grid-area: hello;
      padding-top: 40px;
    }
    .projects {
      grid-area: projects;
      align-self: start;
      margin-top: 28px;
    }
    .education {
      grid-area: edu;
      align-self: start;
      margin-top: 40px;
    }
    .skills {
      grid-area: skills;
      justify-self: start;
      padding-top: 48px;
    }
    .experience {
      grid-area: exp;
      align-self: start;
      margin-top: 40px;
    }
    .contacts {
      grid-area: contacts;
      align-self: end;
      justify-content: space-between;
    }
    /* The 3D figure stands to the right of the skill tiles, as in the reference. */
    .figure {
      grid-area: skills;
      align-self: start;
      justify-self: end;
      width: 150px;
      margin-top: 24px;
    }
    h1 {
      font-size: clamp(48px, min(10vh, 6vw), 84px);
    }
    h1:lang(ja) {
      font-size: clamp(40px, min(8vh, 4.5vw), 64px);
    }
    .education,
    .experience {
      margin-top: 28px;
    }
  }
</style>
