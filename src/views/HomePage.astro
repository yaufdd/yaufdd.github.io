---
import ProjectCard from '../components/ProjectCard.astro';
import StackGroups from '../components/StackGroups.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = await getProjects(locale);
---
<Base locale={locale} path="" description={t(locale, 'home.lead')}>
  <section class="container hero">
    <p class="prompt mono"><span class="accent">$</span> whoami</p>
    <p class="name">{t(locale, 'site.nameFull')}<span class="alt mono">{t(locale, 'site.nameAlt')} · {t(locale, 'home.role')}</span></p>
    <h1>{t(locale, 'home.taglineBefore')}<br /><em>{t(locale, 'home.taglineAccent')}</em>{t(locale, 'home.taglineAfter')}</h1>
    <p class="lead">{t(locale, 'home.lead')}</p>
  </section>

  <section id="projects" class="container block" aria-labelledby="projects-title">
    <h2 id="projects-title" class="section-title">{t(locale, 'home.projects')}</h2>
    <div class="grid">{projects.map((entry) => <ProjectCard locale={locale} entry={entry} />)}</div>
  </section>

  <section class="container block" aria-labelledby="stack-title">
    <h2 id="stack-title" class="section-title">{t(locale, 'home.stack')}</h2>
    <StackGroups locale={locale} />
  </section>
</Base>

<style>
  .hero {
    padding-block: 40px 48px;
  }
  .prompt {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--muted);
  }
  .name {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 500;
  }
  .alt {
    display: inline-block;
    margin-left: 10px;
    font-size: 12.5px;
    font-weight: 400;
    color: var(--muted);
  }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(28px, 6vw, 40px);
    line-height: 1.4;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .lead {
    max-width: 40em;
    margin: 0;
    color: var(--muted);
  }
  .block {
    padding-block: 24px;
  }
  .grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
