---
import { stackGroups } from '../data/profile';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<div class="stack">
  {
    stackGroups.map((group) => (
      <div class="group">
        <h3 class="mono">{t(locale, group.label)}</h3>
        <ul class="tags">{group.items.map((item) => <li>{item}</li>)}</ul>
      </div>
    ))
  }
</div>

<style>
  .stack {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .stack {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
  }
</style>
