---
import '../styles/prose.css';
import { render } from 'astro:content';
import Avatar3D from '../components/Avatar3D.astro';
import { contacts } from '../data/profile';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { Content: About } = await render(await getPage('about', locale));
---
<Base locale={locale} path="about/" title={t(locale, 'about.title')} description={t(locale, 'about.description')}>
  <article class="container page">
    <header class="page-head">
      <div>
        <p class="crumb">~/about</p>
        <h1 class="page-title">{t(locale, 'about.title')}</h1>
      </div>
      <div class="figure"><Avatar3D label={t(locale, 'home.avatarAlt')} /></div>
    </header>
    <div class="prose"><About /></div>

    <section class="contacts" aria-labelledby="contacts-title">
      <h2 id="contacts-title" class="section-title">{t(locale, 'about.contacts')}</h2>
      <ul class="mono">
        <li><a href={contacts.github}>github.com/yaufdd</a></li>
        {contacts.email && <li><a href={`mailto:${contacts.email}`}>{contacts.email}</a></li>}
      </ul>
    </section>
  </article>
</Base>

<style>
  .page {
    padding-bottom: 64px;
  }
  /*
   * The 3D figure sits in the free band between the links above and the text below, so the text stays where it was.
   * On a phone it stands to the right of the title; from tablets up it is larger and centred under the links.
   */
  .page-head {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .figure {
    flex: none;
    width: 84px;
    margin-top: -56px;
  }
  @media (min-width: 720px) {
    .figure {
      position: absolute;
      top: -12px;
      left: 50%;
      width: 108px;
      margin: 0;
      transform: translateX(-50%);
    }
  }
  .contacts {
    margin-top: 48px;
  }
  .contacts ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
</style>
