---
import CaseMeta from '../CaseMeta.astro';
import type { Locale } from '../../i18n/ui';
import { localizePath, t } from '../../i18n/utils';
import { slugOf, type Project } from '../../lib/content';
import Flow from './Flow.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  entry: Project;
  /** The project the last slide points to, if there is another one. */
  next?: Project;
}
const { locale, entry, next } = Astro.props;
const { data } = entry;
const deck = data.deck!;
const slug = slugOf(entry);

const slides = [
  { id: 'cover', label: data.title },
  { id: 'task', label: t(locale, 'deck.task') },
  ...(deck.before ? [{ id: 'before', label: t(locale, 'deck.before') }] : []),
  { id: 'after', label: t(locale, 'deck.after') },
  { id: 'architecture', label: t(locale, 'deck.architecture') },
  { id: 'highlights', label: t(locale, 'deck.highlights') },
  { id: 'outcome', label: t(locale, 'deck.outcome') },
];
const number = (id: string) => String(slides.findIndex((s) => s.id === id) + 1).padStart(2, '0');
---
{/* A case study told as slides: one idea per screen on a computer, a plain column on a phone. */}
<div class="deck">
  <section class="slide cover" id="slide-cover" aria-labelledby="deck-title">
    <a class="back mono" href={localizePath(locale, '')}>{t(locale, 'project.back')}</a>
    <p class="crumb">~/projects/{slug}</p>
    <h1 id="deck-title" class="page-title">{data.title}{data.subtitle && <small>{data.subtitle}</small>}</h1>
    <p class="lead">{data.summary}</p>
    <CaseMeta locale={locale} data={data} />
  </section>

  <section class="slide" id="slide-task" aria-labelledby="slide-task-title">
    <p class="index mono">{number('task')}</p>
    <h2 id="slide-task-title">{t(locale, 'deck.task')}</h2>
    <div class="task">
      <p class="statement" data-reveal style="--i: 1">{deck.task.text}</p>
      {
        deck.task.metric && (
          <div class="metric" data-reveal style="--i: 4">
            <p class="numbers">
              <span class="before">{deck.task.metric.before}</span>
              <small>{deck.task.metric.unit}</small>
              <span class="to" aria-hidden="true">→</span>
              <span class="after">{deck.task.metric.after}</span>
              <small>{deck.task.metric.unit}</small>
            </p>
            <p class="label">{deck.task.metric.label}</p>
            {deck.task.metric.note && <p class="metric-note">{deck.task.metric.note}</p>}
          </div>
        )
      }
    </div>
  </section>

  {
    deck.before && (
      <section class="slide" id="slide-before" aria-labelledby="slide-before-title">
        <p class="index mono">{number('before')}</p>
        <h2 id="slide-before-title">{t(locale, 'deck.before')}</h2>
        <Flow flow={deck.before} />
        {deck.before.note && (
          <p class="note pain" data-reveal style="--i: 9">
            <Icon name="triangle-alert" />
            {deck.before.note}
          </p>
        )}
      </section>
    )
  }

  <section class="slide" id="slide-after" aria-labelledby="slide-after-title">
    <p class="index mono">{number('after')}</p>
    <h2 id="slide-after-title">{t(locale, 'deck.after')}</h2>
    <Flow flow={deck.after} />
    {deck.after.note && <p class="note" data-reveal style="--i: 10">{deck.after.note}</p>}
  </section>

  <section class="slide" id="slide-architecture" aria-labelledby="slide-architecture-title">
    <p class="index mono">{number('architecture')}</p>
    <h2 id="slide-architecture-title">{t(locale, 'deck.architecture')}</h2>
    <div class="arch">
      <ol class="layers">
        {
          deck.architecture.layers.map((layer, i) => (
            <li data-reveal style={`--i: ${i + 1}`}>
              <Icon name={layer.icon} />
              <b>{layer.title}</b>
              {layer.note && <span>{layer.note}</span>}
            </li>
          ))
        }
      </ol>
      <ul class="leaves" style={`--n: ${deck.architecture.leaves.length}`}>
        {
          deck.architecture.leaves.map((leaf, i) => (
            <li data-reveal style={`--i: ${deck.architecture.layers.length + i + 1}`}>
              <Icon name={leaf.icon} />
              <b>{leaf.title}</b>
              {leaf.note && <span>{leaf.note}</span>}
            </li>
          ))
        }
      </ul>
    </div>
    {deck.architecture.note && <p class="note" data-reveal style="--i: 9">{deck.architecture.note}</p>}
  </section>

  <section class="slide" id="slide-highlights" aria-labelledby="slide-highlights-title">
    <p class="index mono">{number('highlights')}</p>
    <h2 id="slide-highlights-title">{t(locale, 'deck.highlights')}</h2>
    <ul class="highlights">
      {
        deck.highlights.map((h, i) => (
          <li data-reveal style={`--i: ${i + 1}`}>
            <b>{h.title}</b>
            <span>{h.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="slide" id="slide-outcome" aria-labelledby="slide-outcome-title">
    <p class="index mono">{number('outcome')}</p>
    <h2 id="slide-outcome-title">{t(locale, 'deck.outcome')}</h2>
    <ul class="outcome">
      {deck.outcome.map((line, i) => <li data-reveal style={`--i: ${i + 1}`}>{line}</li>)}
    </ul>
    <p class="links">
      {next && <a class="next" href={localizePath(locale, `projects/${slugOf(next)}/`)}>{t(locale, 'deck.nextProject')}: {next.data.title} →</a>}
      <a href={localizePath(locale, '')}>{t(locale, 'deck.home')}</a>
    </p>
  </section>

  <details class="more">
    <summary>{t(locale, 'deck.readMore')}</summary>
    <div class="prose"><slot /></div>
  </details>
</div>

<nav class="deck-dots" aria-label={t(locale, 'deck.slides')}>
  {slides.map((s, i) => <a href={`#slide-${s.id}`} aria-label={s.label} aria-current={i === 0 ? 'true' : undefined} />)}
</nav>

<script>
  import { startDeck } from '../../lib/deck';
  import { startMotion } from '../../lib/motion';

  const deck = document.querySelector<HTMLElement>('.deck');
  if (deck) startDeck(deck);
  startMotion();
</script>

<style is:global>
  /* Slides snap gently into place on a computer; never on a phone. */
  @media (min-width: 1100px) and (min-height: 700px) and (hover: hover) {
    html:has(.deck) {
      scroll-snap-type: y proximity;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    html:has(.deck) {
      scroll-behavior: smooth;
    }
  }
</style>

<style>
  .deck {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px 48px;
  }
  .slide {
    display: grid;
    align-content: center;
    gap: 28px;
    padding: 48px 0;
  }
  @media (min-width: 1100px) and (min-height: 700px) {
    .slide {
      box-sizing: border-box;
      height: 100dvh;
      padding: 56px 0;
      overflow: hidden;
      scroll-snap-align: start;
    }
    /* The cover sits under the site header: snapping to it would scroll the header away on opening. */
    .cover {
      scroll-snap-align: none;
    }
  }
  .index {
    margin: 0 0 -20px;
    color: var(--muted);
    font-size: 13px;
  }
  h2 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 900;
    line-height: 1.05;
  }

  /* Cover */
  .cover {
    align-content: start;
    gap: 14px;
  }
  .back {
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--fg);
  }
  .crumb {
    margin: 0;
  }
  .page-title small {
    margin-left: 10px;
    font-size: 16px;
    font-weight: 400;
    color: var(--muted);
  }
  .lead {
    max-width: 46em;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
  }
  .cover :global(.meta) {
    margin: 12px 0 0;
  }

  /* The problem */
  .task {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .task {
      grid-template-columns: 1fr 1fr;
    }
  }
  .statement {
    margin: 0;
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 700;
    line-height: 1.6;
  }
  .metric {
    padding: 28px 32px;
    border-radius: 18px;
    background: var(--tag-bg);
    color: var(--tag-fg);
  }
  .metric p {
    margin: 0;
  }
  .numbers {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    font-weight: 900;
    line-height: 1;
  }
  .numbers .before,
  .numbers .after {
    font-size: clamp(56px, 8vw, 96px);
  }
  .numbers .before {
    color: #9a9a9a;
    text-decoration: line-through;
    text-decoration-thickness: 4px;
  }
  .numbers small {
    font-size: 20px;
    font-weight: 700;
  }
  .numbers .to {
    margin: 0 6px;
    font-size: 40px;
  }
  .label {
    margin-top: 12px !important;
    font-size: 15px;
    font-weight: 700;
  }
  .metric-note {
    margin-top: 6px !important;
    color: #d6d6d6;
    font-size: 14px;
  }

  /* Notes under the flows */
  .note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .pain {
    color: #b3261e;
    font-weight: 700;
  }
  .pain :global(.icon) {
    flex: none;
    width: 22px;
    height: 22px;
  }

  /* Architecture */
  .arch {
    display: grid;
    justify-items: center;
    gap: 36px;
  }
  .arch li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 14px;
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 8px 22px rgb(0 0 0 / 0.05);
  }
  .arch li :global(.icon) {
    grid-row: span 2;
    width: 36px;
    height: 36px;
    padding: 8px;
    border-radius: 50%;
    background: #f1f1f1;
  }
  .arch b {
    font-size: 15px;
    font-weight: 800;
  }
  .arch span {
    color: var(--muted);
    font-size: 12.5px;
  }
  .layers,
  .leaves {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .layers {
    display: grid;
    gap: 30px;
    width: min(100%, 420px);
  }
  /* Down arrows between the layers and from the last layer to the branches. */
  .layers li::after {
    position: absolute;
    top: 100%;
    left: calc(50% - 1px);
    width: 2px;
    height: 30px;
    background: var(--fg);
    content: '';
  }
  .leaves {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 16px;
    width: 100%;
  }
  /* The last layer branches out: down to a bar over the leaves, then down into each leaf. */
  .layers li:last-child::after {
    height: 18px;
  }
  .leaves::before {
    position: absolute;
    top: -18px;
    left: calc(100% / (2 * var(--n)));
    right: calc(100% / (2 * var(--n)));
    height: 2px;
    background: var(--fg);
    content: '';
  }
  .leaves li::before {
    position: absolute;
    bottom: 100%;
    left: calc(50% - 1px);
    width: 2px;
    height: 18px;
    background: var(--fg);
    content: '';
  }
  @media (max-width: 899px) {
    .leaves {
      grid-template-columns: minmax(0, 1fr);
    }
    .leaves::before {
      display: none;
    }
    .leaves li::before {
      height: 16px;
    }
  }
  .leaves li {
    background: var(--tag-bg);
    color: var(--tag-fg);
  }
  .leaves li span {
    color: #d6d6d6;
  }
  .leaves li :global(.icon) {
    background: #4a4a4a;
  }

  /* Highlights */
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .highlights li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
  }
  .highlights b {
    font-size: 16px;
    font-weight: 800;
  }
  .highlights span {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  /* What's next */
  .outcome {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
  }
  .outcome li::before {
    margin-right: 10px;
    content: '→' / '';
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 12px 0 0;
  }
  .links a {
    padding-bottom: 1px;
    border-bottom: 2px solid var(--fg);
    color: var(--fg);
    font-weight: 700;
    text-decoration: none;
  }
  .links a:hover {
    opacity: 0.6;
  }

  /* Read more */
  .more {
    margin-top: 24px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  .more summary {
    cursor: pointer;
    font-weight: 800;
  }

  /* Slide dots */
  .deck-dots {
    position: fixed;
    top: 50%;
    right: 20px;
    z-index: 10;
    display: none;
    gap: 12px;
    transform: translateY(-50%);
  }
  @media (min-width: 1100px) and (min-height: 700px) {
    .deck-dots {
      display: grid;
    }
  }
  .deck-dots a {
    width: 10px;
    height: 10px;
    border: 2px solid var(--fg);
    border-radius: 50%;
    transition: background 0.2s;
  }
  .deck-dots a[aria-current='true'] {
    background: var(--fg);
  }
</style>
