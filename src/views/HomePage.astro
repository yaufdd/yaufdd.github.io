---
import ProjectCard from '../components/ProjectCard.astro';
import StackGroups from '../components/StackGroups.astro';
import type { Locale, UIKey } from '../i18n/ui';
import { localizePath, t } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = await getProjects(locale);

/** Typed one after another by src/lib/motion.ts; the sr-only copy gives screen readers the full text at once. */
const terminal = [`${t(locale, 'site.nameFull')} — ${t(locale, 'site.nameAlt')}`, t(locale, 'home.role')];
const facts: UIKey[] = ['home.fact1', 'home.fact2', 'home.fact3'];
const what: [UIKey, UIKey][] = [
  ['home.what1Title', 'home.what1Text'],
  ['home.what2Title', 'home.what2Text'],
  ['home.what3Title', 'home.what3Text'],
];
---
<Base locale={locale} path="" description={t(locale, 'home.lead')}>
  <section class="container hero">
    <p class="prompt mono">
      <span class="accent">$</span>{' '}<span class="sr-only">whoami</span><span data-type aria-hidden="true">whoami</span><span class="cursor" aria-hidden="true"></span>
    </p>
    {
      terminal.map((line, i) => (
        <p class:list={['out', 'mono', { muted: i > 0 }]}>
          <span class="sr-only">{line}</span>
          <span data-type aria-hidden="true">{line}</span>
        </p>
      ))
    }
    <h1 data-reveal style="--i: 4">{t(locale, 'home.taglineBefore')}<br /><em>{t(locale, 'home.taglineAccent')}</em>{t(locale, 'home.taglineAfter')}</h1>
    <p class="lead" data-reveal style="--i: 5">{t(locale, 'home.lead')}</p>
    <ul class="facts mono" data-reveal style="--i: 6">
      {facts.map((key) => <li><span class="accent" aria-hidden="true">▸</span>{t(locale, key)}</li>)}
    </ul>
    <div class="ctas mono" data-reveal style="--i: 7">
      <a class="btn primary" href={localizePath(locale, '#projects')}>{t(locale, 'home.ctaProjects')}</a>
      <a class="btn ghost" href={localizePath(locale, 'about/')}>{t(locale, 'home.ctaAbout')}</a>
    </div>
  </section>

  <section id="what" class="container block" aria-labelledby="what-title">
    <h2 id="what-title" class="section-title" data-reveal>{t(locale, 'home.whatTitle')}</h2>
    <p class="sub" data-reveal>{t(locale, 'home.whatSub')}</p>
    <ol class="what">
      {
        what.map(([title, text], i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="n mono">0{i + 1}</span>
            <h3>{t(locale, title)}</h3>
            <p>{t(locale, text)}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="projects" class="container block" aria-labelledby="projects-title">
    <h2 id="projects-title" class="section-title" data-reveal>{t(locale, 'home.projects')}</h2>
    <p class="sub" data-reveal>{t(locale, 'home.projectsSub')}</p>
    <div class="grid">{projects.map((entry, i) => <ProjectCard locale={locale} entry={entry} index={i} />)}</div>
  </section>

  <section class="container block" aria-labelledby="stack-title">
    <h2 id="stack-title" class="section-title" data-reveal>{t(locale, 'home.stack')}</h2>
    <div data-reveal><StackGroups locale={locale} /></div>
  </section>
</Base>

<script>
  import { startMotion } from '../lib/motion';
  startMotion();
</script>

<style>
  .hero {
    padding-block: 40px 48px;
  }
  .prompt,
  .out {
    margin: 0;
    min-height: 1.7em;
    font-size: 13px;
  }
  .prompt {
    color: var(--muted);
  }
  .out {
    color: var(--fg);
  }
  .out.muted {
    color: var(--muted);
  }
  h1 {
    margin: 20px 0 14px;
    font-size: clamp(28px, 6vw, 40px);
    line-height: 1.4;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .lead {
    max-width: 36em;
    margin: 0 0 18px;
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    font-size: 12px;
  }
  .facts .accent {
    margin-right: 6px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn {
    padding: 9px 16px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    font-size: 13px;
    text-decoration: none;
    transition:
      translate 0.15s,
      box-shadow 0.15s;
  }
  .btn.primary {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }
  .btn.ghost {
    color: var(--accent);
  }
  .btn:hover {
    translate: 0 -2px;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .block {
    padding-block: 24px;
  }
  .sub {
    margin: -12px 0 18px;
    font-size: 14px;
    color: var(--muted);
  }
  .what {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .what {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .what li {
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .what .n {
    font-size: 12px;
    color: var(--accent);
  }
  .what h3 {
    margin: 4px 0 6px;
    font-size: 15px;
  }
  .what p {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
