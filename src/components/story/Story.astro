---
import { Image } from 'astro:assets';
import Avatar3D from '../Avatar3D.astro';
import CaseMeta from '../CaseMeta.astro';
import type { Locale } from '../../i18n/ui';
import { localizePath, t } from '../../i18n/utils';
import { slugOf, type Project } from '../../lib/content';
import Flow from './Flow.astro';
import Icon from './Icon.astro';
import Screens from './Screens.astro';

interface Props {
  locale: Locale;
  entry: Project;
  /** The project the last section points to, if there is another one. */
  next?: Project;
}
const { locale, entry, next } = Astro.props;
const { data } = entry;
const story = data.story!;
const slug = slugOf(entry);
// `**…**` in the problem text marks the bold bits: odd-numbered parts.
const docs = story.task.documents;
const taskParts = story.task.text.split(/\*\*(.+?)\*\*/);
---
{/* A case study told visually on one continuous page: short sections with cards, arrows and numbers. Nothing else: the Markdown body of a story project stays empty. */}
<div class="story">
  <section class="cover" id="story-cover" aria-labelledby="story-title">
    <a class="back mono" href={localizePath(locale, '')}>{t(locale, 'project.back')}</a>
    <p class="crumb">~/projects/{slug}</p>
    <h1 id="story-title" class="page-title">{data.title}{data.subtitle && <small>{data.subtitle}</small>}</h1>
    <p class="lead">{data.summary}</p>
    {story.screens?.at === 'top' && <Screens locale={locale} screens={story.screens} />}
    <CaseMeta locale={locale} data={data} />
  </section>

  <section id="story-task" aria-labelledby="story-task-title">
    <h2 id="story-task-title">{t(locale, 'story.task')}</h2>
    <p class="statement">{taskParts.map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</p>
    {
      docs && (
        <div class="docs">
          <div>
            <h3>{docs.title}</h3>
            <ul>
              {docs.items.map((item) => (
                <li>
                  <Icon name="file-text" />
                  {item}
                </li>
              ))}
            </ul>
            {docs.note && <p class="docs-note">{docs.note}</p>}
          </div>
          {docs.example && (
            <figure class="example">
              <a href={docs.example.href} target="_blank" rel="noopener">
                <Image src={docs.example.image} alt={docs.example.alt} widths={[220, 440]} sizes="220px" />
              </a>
              <figcaption>{docs.example.caption}</figcaption>
            </figure>
          )}
        </div>
      )
    }
  </section>

  <section id="story-change" aria-labelledby="story-change-title">
    <h2 id="story-change-title">{t(locale, story.before ? 'story.change' : 'story.after')}</h2>
    {
      story.before && (
        <div class="row">
          <h3>{t(locale, 'story.before')}</h3>
          <Flow flow={story.before} kind="before" />
          {story.before.note && (
            <p class="note pain">
              <Icon name="triangle-alert" />
              {story.before.note}
            </p>
          )}
        </div>
      )
    }
    <div class="row">
      {story.before && <h3>{t(locale, 'story.after')}</h3>}
      <Flow flow={story.after} kind="after" />
      {story.after.note && <p class="note">{story.after.note}</p>}
    </div>
  </section>

  {story.screens?.at === 'middle' && <Screens locale={locale} screens={story.screens} />}

  <section id="story-architecture" aria-labelledby="story-architecture-title">
    <h2 id="story-architecture-title">{t(locale, 'story.architecture')}</h2>
    <div class="arch">
      <ol class="layers">
        {
          story.architecture.layers.map((layer) => (
            <li>
              <Icon name={layer.icon} />
              <b>{layer.title}</b>
              {layer.note && <span>{layer.note}</span>}
            </li>
          ))
        }
      </ol>
      <ul class="leaves" style={`--n: ${story.architecture.leaves.length}`}>
        {
          story.architecture.leaves.map((leaf) => (
            <li>
              <Icon name={leaf.icon} />
              <b>{leaf.title}</b>
              {leaf.note && <span>{leaf.note}</span>}
            </li>
          ))
        }
      </ul>
    </div>
    {story.architecture.note && <p class="note">{story.architecture.note}</p>}
  </section>

  <section id="story-highlights" aria-labelledby="story-highlights-title">
    <h2 id="story-highlights-title">{t(locale, 'story.highlights')}</h2>
    <ul class="highlights">
      {
        story.highlights.map((h) => (
          <li>
            <b>{h.title}</b>
            <span>{h.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="story-outcome" aria-labelledby="story-outcome-title">
    <h2 id="story-outcome-title">{t(locale, 'story.outcome')}</h2>
    <div class="outcome-row">
      <div>
        <div class="outcome">
          {story.outcome.map((line) => <p>{line}</p>)}
        </div>
        <p class="links">
          {next && <a class="next" href={localizePath(locale, `projects/${slugOf(next)}/`)}>{t(locale, 'story.nextProject')}: {next.data.title} →</a>}
          <a href={localizePath(locale, '')}>{t(locale, 'story.home')}</a>
        </p>
      </div>
      <div class="figure"><Avatar3D label={t(locale, 'home.avatarAlt')} /></div>
    </div>
  </section>
</div>


<style>
  .story {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px 48px;
  }
  .story > section {
    display: grid;
    gap: 24px;
    padding: 56px 0;
  }
  .story > section + section,
  .story > :global(figure) + section {
    border-top: 1px solid var(--border);
  }
  h2 {
    margin: 0;
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 900;
    line-height: 1.1;
  }

  /* Cover */
  .story > .cover {
    gap: 14px;
    padding-top: 24px;
  }
  .back {
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--fg);
  }
  .crumb {
    margin: 0;
  }
  .page-title small {
    margin-left: 10px;
    font-size: 16px;
    font-weight: 400;
    color: var(--muted);
  }
  .lead {
    max-width: 46em;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
  }
  .cover :global(.meta) {
    margin: 12px 0 0;
  }

  /* The problem: plain text, the times in bold. */
  .statement {
    max-width: 46em;
    margin: 0;
    font-size: 17px;
    line-height: 1.9;
  }
  .statement strong {
    font-weight: 800;
  }
  /* The paperwork: a plain list of the documents, and one real form as an example. */
  .docs {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 48px;
    }
  }
  .docs ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 8px 24px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .docs li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
  }
  .docs li :global(.icon) {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--muted);
  }
  .docs-note {
    margin: 16px 0 0;
    font-size: 15px;
    line-height: 1.8;
  }
  .example {
    margin: 0;
  }
  .example a {
    display: block;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 8px 20px rgb(0 0 0 / 0.06);
  }
  .example :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .example figcaption {
    margin-top: 8px;
    color: var(--muted);
    font-size: 12.5px;
  }
  @media (max-width: 899px) {
    .example {
      width: min(220px, 60%);
    }
  }

  /* Before and now: two rows in one section. */
  .row {
    display: grid;
    gap: 14px;
  }
  .row + .row {
    margin-top: 16px;
  }
  h3 {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  /* Notes under the flows */
  .note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  /* The pain, in plain words: the same quiet grey as the other notes, with a small warning sign. */
  .pain {
    align-items: flex-start;
    max-width: 46em;
    line-height: 1.7;
  }
  .pain :global(.icon) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 4px;
  }

  /* Architecture */
  .arch {
    display: grid;
    justify-items: center;
    gap: 36px;
  }
  .arch li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 14px;
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 8px 22px rgb(0 0 0 / 0.05);
  }
  .arch li :global(.icon) {
    grid-row: span 2;
    width: 36px;
    height: 36px;
    padding: 8px;
    border-radius: 50%;
    background: #f1f1f1;
  }
  .arch b {
    font-size: 15px;
    font-weight: 800;
  }
  .arch span {
    color: var(--muted);
    font-size: 12.5px;
  }
  .layers,
  .leaves {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .layers {
    display: grid;
    gap: 30px;
    width: min(100%, 420px);
  }
  /* Down arrows between the layers and from the last layer to the branches. */
  .layers li::after {
    position: absolute;
    top: 100%;
    left: calc(50% - 1px);
    width: 2px;
    height: 30px;
    background: var(--fg);
    content: '';
  }
  .leaves {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 16px;
    width: 100%;
  }
  /* The last layer branches out: down to a bar over the leaves, then down into each leaf. */
  .layers li:last-child::after {
    height: 18px;
  }
  .leaves::before {
    position: absolute;
    top: -18px;
    left: calc(100% / (2 * var(--n)));
    right: calc(100% / (2 * var(--n)));
    height: 2px;
    background: var(--fg);
    content: '';
  }
  .leaves li::before {
    position: absolute;
    bottom: 100%;
    left: calc(50% - 1px);
    width: 2px;
    height: 18px;
    background: var(--fg);
    content: '';
  }
  @media (max-width: 899px) {
    .leaves {
      grid-template-columns: minmax(0, 1fr);
    }
    .leaves::before {
      display: none;
    }
    .leaves li::before {
      height: 16px;
    }
  }
  .leaves li {
    background: var(--tag-bg);
    color: var(--tag-fg);
  }
  .leaves li span {
    color: #d6d6d6;
  }
  .leaves li :global(.icon) {
    background: #4a4a4a;
  }

  /* Highlights */
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .highlights li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
  }
  .highlights b {
    font-size: 16px;
    font-weight: 800;
  }
  .highlights span {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  /* Outcome: where things stand now, with the 3D figure beside it (under it on a phone). */
  .outcome-row {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .outcome-row {
      grid-template-columns: minmax(0, 1fr) 180px;
      gap: 56px;
    }
  }
  .outcome {
    display: grid;
    gap: 10px;
    max-width: 40em;
    font-size: 17px;
    line-height: 1.8;
  }
  .outcome p {
    margin: 0;
  }
  .figure {
    width: 160px;
    justify-self: center;
  }
  @media (min-width: 900px) {
    .figure {
      width: 180px;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 12px 0 0;
  }
  .links a {
    padding-bottom: 1px;
    border-bottom: 2px solid var(--fg);
    color: var(--fg);
    font-weight: 700;
    text-decoration: none;
  }
  .links a:hover {
    opacity: 0.6;
  }

</style>
