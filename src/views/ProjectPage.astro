---
import '../styles/prose.css';
import { render } from 'astro:content';
import Avatar3D from '../components/Avatar3D.astro';
import CaseMeta from '../components/CaseMeta.astro';
import Story from '../components/story/Story.astro';
import Lightbox from '../components/Lightbox.astro';
import type { Locale } from '../i18n/ui';
import { localizePath, t } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { getProjects, slugOf, type Project } from '../lib/content';

interface Props {
  locale: Locale;
  entry: Project;
}
const { locale, entry } = Astro.props;
const { data } = entry;
const slug = slugOf(entry);
const { Content } = await render(entry);
// The project the story's last section points to: the next one in the home page order, wrapping around.
const projects = await getProjects(locale);
const at = projects.findIndex((p) => slugOf(p) === slug);
const next = projects.length > 1 ? projects[(at + 1) % projects.length] : undefined;
---
<Base locale={locale} path={`projects/${slug}/`} title={data.title} description={data.summary} ogImage={data.cover}>
  {
    data.story ? (
      <Story locale={locale} entry={entry} next={next} />
    ) : (
      <article class="container case">
        <a class="back mono" href={localizePath(locale, '')}>{t(locale, 'project.back')}</a>
        <p class="crumb">~/projects/{slug}</p>
        <h1 class="page-title">{data.title}{data.subtitle && <small>{data.subtitle}</small>}</h1>
        <p class="lead">{data.summary}</p>
        <CaseMeta locale={locale} data={data} />
        <div class="body">
          <div class="prose"><Content /></div>
          <div class="figure"><Avatar3D label={t(locale, 'home.avatarAlt')} /></div>
        </div>
      </article>
    )
  }
  <Lightbox locale={locale} />
</Base>

<style>
  .case {
    padding-bottom: 64px;
  }
  /*
   * The 3D figure stands to the right of the last section (the retrospective): that section is narrower, and the
   * figure sits at the bottom right of the text. On a phone it comes under the text.
   */
  .figure {
    width: 150px;
    margin: 32px auto 0;
  }
  @media (min-width: 900px) {
    .body {
      position: relative;
    }
    .prose :global(h2:last-of-type),
    .prose :global(h2:last-of-type ~ *) {
      margin-right: 200px;
    }
    .figure {
      position: absolute;
      right: 0;
      bottom: 0;
      margin: 0;
    }
  }
  .back {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--fg);
  }
  .page-title small {
    margin-left: 10px;
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }
  .lead {
    margin: 0;
    color: var(--muted);
  }
</style>
