---
import type { Locale } from '../i18n/ui';
import { localizePath, t } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Locale-neutral path of the current page; the language links point at its translations. */
  path: string;
  /** Home page: only the language switch, like the reference design. */
  bare?: boolean;
}
const { locale, path, bare = false } = Astro.props;
const links = [
  { href: localizePath(locale, 'about/'), label: t(locale, 'nav.about') },
  { href: localizePath(locale, 'about/#workflow'), label: t(locale, 'nav.workflow') },
];
---
<header class:list={['site-header', 'container', { bare }]}>
  {!bare && <a class="logo" href={localizePath(locale, '')}>{t(locale, 'site.name')}</a>}
  {
    !bare && (
      <nav aria-label={t(locale, 'a11y.mainNav')}>
        <ul class="links">
          {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    )
  }
  <div class="lang" role="group" aria-label={t(locale, 'nav.language')}>
    <a href={localizePath('ja', path)} hreflang="ja" lang="ja" aria-current={locale === 'ja' ? 'true' : undefined}>JA</a>
    <span aria-hidden="true">|</span>
    <a href={localizePath('en', path)} hreflang="en" lang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  .site-header.bare {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 5;
    justify-content: flex-end;
    max-width: none;
    width: auto;
  }
  .logo {
    color: var(--fg);
    font-size: 15px;
    font-weight: 900;
    text-decoration: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a,
  .lang a {
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  .links a:hover,
  .lang a:hover,
  .lang a[aria-current] {
    color: var(--fg);
  }
  .lang {
    display: flex;
    gap: 6px;
  }
</style>
