---
import '../styles/prose.css';
import { render } from 'astro:content';
import CaseMeta from '../components/CaseMeta.astro';
import Lightbox from '../components/Lightbox.astro';
import type { Locale } from '../i18n/ui';
import { localizePath, t } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { slugOf, type Project } from '../lib/content';

interface Props {
  locale: Locale;
  entry: Project;
}
const { locale, entry } = Astro.props;
const { data } = entry;
const slug = slugOf(entry);
const { Content } = await render(entry);
---
<Base locale={locale} path={`projects/${slug}/`} title={data.title} description={data.summary} ogImage={data.cover}>
  <article class="container case">
    <a class="back mono" href={localizePath(locale, '#projects')}>{t(locale, 'project.back')}</a>
    <p class="crumb">~/projects/{slug}</p>
    <h1 class="page-title">{data.title}{data.subtitle && <small>{data.subtitle}</small>}</h1>
    <p class="lead">{data.summary}</p>
    <CaseMeta locale={locale} data={data} />
    <div class="prose"><Content /></div>
  </article>
  <Lightbox locale={locale} />
</Base>

<style>
  .case {
    padding-bottom: 64px;
  }
  .back {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--fg);
  }
  .page-title small {
    margin-left: 10px;
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }
  .lead {
    margin: 0;
    color: var(--muted);
  }
</style>
