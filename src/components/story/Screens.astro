---
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import type { Project } from '../../lib/content';

type Screens = NonNullable<NonNullable<Project['data']['story']>['screens']>;

interface Props {
  locale: Locale;
  screens: Screens;
}
const { locale, screens } = Astro.props;
// A tall phone screen next to wide desktop screens: the wide ones stack on the left, the phone stands beside them.
const isPortrait = (shot: Screens['items'][number]) => shot.image.height > shot.image.width;
const wide = screens.items.filter((shot) => !isPortrait(shot)).length;
const mixed = wide > 0 && wide < screens.items.length;
---
{/* Example screens: no heading, just the pictures (click to enlarge in the screenshot viewer) and one caption. */}
<figure class:list={['screens', screens.at]} data-lightbox>
  <div class:list={['shots', { mixed }]} style={mixed ? `--rows: ${wide}` : undefined}>
    {
      screens.items.map((shot) => (
        <Image src={shot.image} alt={shot.alt} class:list={{ portrait: isPortrait(shot) }} widths={[480, 960, 1600]} sizes="(min-width: 1100px) 560px, 100vw" />
      ))
    }
  </div>
  <figcaption>
    <span class="caption">{screens.caption}</span>
    <span class="mock-note">{t(locale, 'story.mockNote')}</span>
  </figcaption>
</figure>

<style>
  .screens {
    margin: 0;
  }
  .screens.middle {
    padding: 8px 0 56px;
  }
  .screens.top {
    margin: 10px 0 6px;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  @media (min-width: 900px) {
    .shots.mixed {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: start;
    }
    .shots.mixed :global(img:not(.portrait)) {
      grid-column: 1;
    }
    .shots.mixed :global(img.portrait) {
      grid-column: 2;
      grid-row: 1 / span var(--rows);
    }
  }
  .shots :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 10px 24px rgb(0 0 0 / 0.06);
  }
  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
  }
  .mock-note {
    font-size: 12px;
  }
</style>
