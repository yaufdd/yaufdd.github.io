{/* Sakura petals falling from the mouse pointer (src/lib/sakura.ts); never on touch screens or with reduced motion. */}
<canvas class="sakura" data-sakura aria-hidden="true"></canvas>

<script>
  import { startSakura } from '../lib/sakura';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-sakura]');
  if (canvas) startSakura(canvas);
</script>

<style is:global>
  /* The arrow is hidden while the petals run (class set by startSakura). */
  html.sakura-cursor,
  html.sakura-cursor * {
    cursor: none !important;
  }
  /* A modal (the screenshot viewer) sits above the petals' canvas: there the normal arrow comes back. */
  html.sakura-cursor:has(dialog[open]),
  html.sakura-cursor:has(dialog[open]) * {
    cursor: auto !important;
  }
  html.sakura-cursor:has(dialog[open]) dialog :is(button, a) {
    cursor: pointer !important;
  }
</style>

<style>
  .sakura {
    position: fixed;
    inset: 0;
    z-index: 50;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
