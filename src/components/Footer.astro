---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer container mono">
  <span>© {year} {t(locale, 'site.name')}</span>
  <a href="https://github.com/yaufdd">github.com/yaufdd</a>
  <a href="https://github.com/yaufdd/yaufdd.github.io">{t(locale, 'footer.source')}</a>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 40px;
    margin-top: 48px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--fg);
  }
</style>
